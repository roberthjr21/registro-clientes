<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/app_name"
            android:textColor="#12363A"
            android:textSize="30sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etId"
            style="@style/ClientField"
            android:hint="@string/id"
            android:inputType="number" />

        <EditText
            android:id="@+id/etNombre"
            style="@style/ClientField"
            android:hint="@string/name"
            android:inputType="textPersonName|textCapWords" />

        <EditText
            android:id="@+id/etCorreo"
            style="@style/ClientField"
            android:hint="@string/email"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/etTelefono"
            style="@style/ClientField"
            android:hint="@string/phone"
            android:inputType="phone" />

        <Button
            android:id="@+id/btnGuardar"
            style="@style/ClientButton"
            android:backgroundTint="#12636A"
            android:text="@string/save"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnConsultar"
            style="@style/ClientButton"
            android:text="@string/search" />

        <Button
            android:id="@+id/btnActualizar"
            style="@style/ClientButton"
            android:text="@string/update" />

        <Button
            android:id="@+id/btnEliminar"
            style="@style/ClientButton"
            android:text="@string/delete" />

        <Button
            android:id="@+id/btnLimpiar"
            style="@style/ClientButton"
            android:text="@string/clear" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/search_help"
            android:textColor="#435759"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:background="#E4EFED"
            android:freezesText="true"
            android:padding="16dp"
            android:text="@string/result_placeholder"
            android:textColor="#153133"
            android:textIsSelectable="true"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
